# Copy to .env (gitignored) for docker compose. All optional.
# QN_BIND=127.0.0.1                 # host address to publish on (your LAN IP to play from your phone)
# QN_PORT=8765                      # host port
# QN_GPU=1                          # nvidia-smi index of the GPU the container gets (default: the second GPU)
# QN_MODEL_DIR=/path/to/Qwen3.5-4B  # local weights, mounted read-only; leave unset to download from Hugging Face
# QN_IDLE_TIMEOUT_S=600             # unload the model (free all VRAM) after this many idle seconds
