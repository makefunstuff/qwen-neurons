# Copy to config.local.env (gitignored) and edit. Environment variables of the same name win.
# QN_HOST=127.0.0.1            # bind address (e.g. your LAN IP to reach it from other devices)
# QN_PORT=8765
# QN_MODEL=Qwen/Qwen3.5-4B     # HF repo id (downloaded on first run) or a local directory with the weights
# QN_DEVICE=auto               # auto | cuda:N (nvidia-smi numbering) | mps | cpu
# QN_NEED_MIB=10000            # free VRAM needed before loading on a GPU
# QN_IDLE_TIMEOUT_S=600        # unload the model (free all VRAM) after this many idle seconds
# QN_DATA_DIR=./data           # where your bred creatures, prompt sets and gene pool are saved
# QN_NO_BROWSER=1              # never open a browser tab
# The Lab agent's brain (🕵️ Agent tab). Without a key it uses the plain local Qwen.
# QN_AGENT_PROVIDER=deepseek   # deepseek | openai (any OpenAI-compatible endpoint) | qwen
# QN_AGENT_BASE_URL=https://api.deepseek.com
# QN_AGENT_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=            # or QN_AGENT_API_KEY, or a key file: QN_AGENT_KEY_FILE=~/.config/qwen-neurons/agent.key
